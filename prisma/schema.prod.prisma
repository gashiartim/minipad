generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Note {
  id            String   @id @default(cuid())
  slug          String   @unique
  content       String   @default("")
  contentRich   String?
  contentFormat String   @default("plain")
  secret        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  images        Image[]
}

model Image {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  path      String
  mime      String
  width     Int?
  height    Int?
  sizeBytes Int
  createdAt DateTime @default(now())
}